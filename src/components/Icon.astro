---
interface Props {
  name: "arrow" | "phone" | "message" | "check" | "pin" | "menu" | "calendar" | "wrench" | "home" | "shield" | "chat";
  size?: number;
  className?: string;
}

const { name, size = 20, className = "" } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {name === "arrow" && <><path d="M5 19 19 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 5h10v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></>}
  {name === "phone" && <path d="M8.2 3.5 6.3 4.6c-.9.5-1.3 1.6-1 2.6 1.7 5.4 5.9 9.6 11.3 11.3 1 .3 2.1-.1 2.6-1l1.1-1.9c.5-.9.2-2-.6-2.5l-2.7-1.7c-.8-.5-1.9-.3-2.4.5l-.8 1.1a13.3 13.3 0 0 1-2.8-2.1 13.3 13.3 0 0 1-2.1-2.8l1.1-.8c.8-.5 1-1.6.5-2.4L10.7 4c-.5-.8-1.6-1-2.5-.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>}
  {(name === "message" || name === "chat") && <><path d="M20.5 11.3a8.3 8.3 0 0 1-9 8.2 8 8 0 0 1-3.7-1L3.5 20l1.4-4A8.4 8.4 0 1 1 20.5 11.3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 11.5h8M8 8.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></>}
  {name === "check" && <path d="m5 12 4.2 4.2L19.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === "pin" && <><path d="M20 10c0 5-8 11-8 11s-8-6-8-11a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>}
  {name === "calendar" && <><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="14" r="1" fill="currentColor"/><circle cx="12" cy="14" r="1" fill="currentColor"/><circle cx="16" cy="14" r="1" fill="currentColor"/><circle cx="8" cy="18" r="1" fill="currentColor"/><circle cx="12" cy="18" r="1" fill="currentColor"/></>}
  {name === "wrench" && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>}
  {name === "home" && <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.8"/>}
  {name === "shield" && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>}
</svg>
